diff --git a/DOSBox/include/boxer_host_sdl.h b/DOSBox/include/boxer_host_sdl.h
new file mode 100644
index 0000000000000000000000000000000000000000..0828dfb246bab9adc3fed5170b1fe76895c5a056
--- /dev/null
+++ b/DOSBox/include/boxer_host_sdl.h
@@ -0,0 +1,50 @@
+/* Host SDL seam for non-Apple builds of Boxer's DOSBox 0.74 core.
+ *
+ * Boxer linked SDL 1.2 frameworks; on AROS the core uses SDL2 instead
+ * (installed in both the ABIv11 and mainline SDKs; SDL3 is the preferred
+ * later target, so all SDL use stays behind this one header).
+ * SDL2 dropped the SDL 1.2 CD-ROM API. Physical-drive CD access through it
+ * is reported as "no drives"; image-based CDs (ISO/CUE) do not use it.
+ */
+#ifndef BOXER_HOST_SDL_H
+#define BOXER_HOST_SDL_H
+
+#include <SDL2/SDL.h>
+
+#define SDL_INIT_CDROM 0
+
+#define SDL_MAX_TRACKS 99
+#define SDL_AUDIO_TRACK 0x00
+#define SDL_DATA_TRACK  0x04
+#define CD_FPS 75
+/* Frame/MSF conversions are used by image CDs too, not only by the API. */
+#define FRAMES_TO_MSF(f, M, S, F) { int value = f; \
+	*(F) = value % CD_FPS; value /= CD_FPS; \
+	*(S) = value % 60; value /= 60; *(M) = value; }
+#define MSF_TO_FRAMES(M, S, F) ((M) * 60 * CD_FPS + (S) * CD_FPS + (F))
+
+typedef enum { CD_TRAYEMPTY, CD_STOPPED, CD_PLAYING, CD_PAUSED, CD_ERROR = -1 } CDstatus;
+#define CD_INDRIVE(status) ((int)(status) > 0)
+
+typedef struct SDL_CDtrack {
+	Uint8 id, type; Uint16 unused; Uint32 length, offset;
+} SDL_CDtrack;
+
+typedef struct SDL_CD {
+	int id; CDstatus status; int numtracks, cur_track, cur_frame;
+	SDL_CDtrack track[SDL_MAX_TRACKS + 1];
+} SDL_CD;
+
+static inline int SDL_CDNumDrives(void) { return 0; }
+static inline const char *SDL_CDName(int) { return ""; }
+static inline SDL_CD *SDL_CDOpen(int) { SDL_SetError("CD-ROM API not available"); return NULL; }
+static inline CDstatus SDL_CDStatus(SDL_CD *) { return CD_ERROR; }
+static inline int SDL_CDPlay(SDL_CD *, int, int) { return -1; }
+static inline int SDL_CDPlayTracks(SDL_CD *, int, int, int, int) { return -1; }
+static inline int SDL_CDPause(SDL_CD *) { return -1; }
+static inline int SDL_CDResume(SDL_CD *) { return -1; }
+static inline int SDL_CDStop(SDL_CD *) { return -1; }
+static inline int SDL_CDEject(SDL_CD *) { return -1; }
+static inline void SDL_CDClose(SDL_CD *) {}
+
+#endif
