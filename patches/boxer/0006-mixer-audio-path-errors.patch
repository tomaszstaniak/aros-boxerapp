@@ -72,6 +72,14 @@ static inline void MIXER_UnlockHost(void) { SDL_UnlockAudio(); }
 #endif
 //Counters for the port's audio measurements (MIXER_GetHostStats).
 static MixerHostStats mixer_stats;
+//First host API error, kept for the session's audio line; also logged.
+//Not logged from the device thread (log=false): the core's log is not
+//thread-safe; the stats line carries it.
+static void MIXER_HostError(const char *what,bool log=true) {
+	if (log) LOG_MSG("MIXER:%s failed: %s",what,SDL_GetError());
+	if (!mixer_stats.error[0])
+		snprintf(mixer_stats.error,sizeof(mixer_stats.error),"%s: %s",what,SDL_GetError());
+}
 //--End of modifications
 
 static INLINE Bit16s MIXER_CLIP(Bits SAMP) {
@@ -425,6 +433,7 @@ static void MIXER_Mix(void) {
 	mixer_stats.mix_ticks++;
 	MIXER_MixData(mixer.needed);
 	mixer.tick_remain+=mixer.tick_add;
+	mixer_stats.frames_mixed+=(mixer.tick_remain>>MIXER_SHIFT);
 	mixer.needed+=(mixer.tick_remain>>MIXER_SHIFT);
 	mixer.tick_remain&=MIXER_REMAIN;
 	MIXER_UnlockHost();
@@ -458,6 +467,12 @@ static void MIXER_CallBack(void * userdata, Uint8 *stream, int len) {
 	Bits sample;
 	mixer_stats.callbacks++;
 	mixer_stats.frames_requested+=need;
+	{
+		Bit32u now=SDL_GetTicks();
+		if (mixer_stats.cb_last_ms && now-mixer_stats.cb_last_ms>mixer_stats.cb_gap_max_ms)
+			mixer_stats.cb_gap_max_ms=now-mixer_stats.cb_last_ms;
+		mixer_stats.cb_last_ms=now;
+	}
 	/* Enough room in the buffer ? */
 	if (mixer.done < need) {
 //		LOG_MSG("Full underrun need %d, have %d, min %d", need, mixer.done, mixer.min_needed);
@@ -466,6 +481,7 @@ static void MIXER_CallBack(void * userdata, Uint8 *stream, int len) {
 			return;
 		}
 		mixer_stats.underruns_stretched++;
+		mixer_stats.frames_delivered+=need;
 		reduce = mixer.done;
 		index_add = (reduce << MIXER_SHIFT) / need;
 		mixer.tick_add = ((mixer.freq+mixer.min_needed) << MIXER_SHIFT)/1000;
@@ -517,6 +533,7 @@ static void MIXER_CallBack(void * userdata, Uint8 *stream, int len) {
 		reduce = mixer.done - 2* mixer.min_needed;
 		mixer.tick_add = ((mixer.freq-(mixer.min_needed/5)) << MIXER_SHIFT)/1000;
 	}
+	if (mixer.done >= need) mixer_stats.frames_delivered+=need;
 	/* Reduce done count in all channels */
 	for (MixerChannel * chan=mixer.channels;chan;chan=chan->next) {
 		if (chan->done>reduce) chan->done-=reduce;
@@ -575,7 +592,17 @@ static void SDLCALL MIXER_StreamCallBack(void *userdata, SDL_AudioStream *stream
 		int len=additional>(int)sizeof(chunk)?(int)sizeof(chunk):additional;
 		memset(chunk,0,len);
 		MIXER_CallBack(userdata,chunk,len);
-		SDL_PutAudioStreamData(stream,chunk,len);
+		mixer_stats.put_calls++;
+		if (!SDL_PutAudioStreamData(stream,chunk,len)) {
+			mixer_stats.put_failures++;
+			MIXER_HostError("SDL_PutAudioStreamData",false);
+			break;
+		}
+		mixer_stats.put_bytes+=len;
+		{
+			int q=SDL_GetAudioStreamQueued(stream);
+			if (q>0 && (Bit32u)q>mixer_stats.queued_max) mixer_stats.queued_max=q;
+		}
 		additional-=len;
 	}
 }
@@ -608,10 +635,20 @@ static void MIXER_Stop(Section* sec) {
 void MIXER_SetHostPaused(bool paused) {
 #ifdef BOXER_HOST_SDL3
 	if (!mixer_stream) return;
-	if (paused) SDL_PauseAudioStreamDevice(mixer_stream);
-	else SDL_ResumeAudioStreamDevice(mixer_stream);
+	mixer_stats.pause_calls++;
+	if (!(paused ? SDL_PauseAudioStreamDevice(mixer_stream) : SDL_ResumeAudioStreamDevice(mixer_stream))) {
+		mixer_stats.pause_failures++;
+		MIXER_HostError(paused ? "SDL_PauseAudioStreamDevice" : "SDL_ResumeAudioStreamDevice");
+	}
 #else
+	//SDL_PauseAudio reports nothing; check the device state it should reach.
+	if (mixer.nosound || mixer_stopped) return;
+	mixer_stats.pause_calls++;
 	SDL_PauseAudio(paused ? 1 : 0);
+	if (SDL_GetAudioStatus()!=(paused ? SDL_AUDIO_PAUSED : SDL_AUDIO_PLAYING)) {
+		mixer_stats.pause_failures++;
+		MIXER_HostError(paused ? "SDL_PauseAudio(1)" : "SDL_PauseAudio(0)");
+	}
 #endif
 }
 
