@@ -1,15 +1,34 @@
 /* Host SDL seam for non-Apple builds of Boxer's DOSBox 0.74 core.
  *
- * Boxer linked SDL 1.2 frameworks; on AROS the core uses SDL2 instead
- * (installed in both the ABIv11 and mainline SDKs; SDL3 is the preferred
- * later target, so all SDL use stays behind this one header).
+ * Boxer linked SDL 1.2 frameworks; on AROS the core uses SDL2 (installed
+ * in both SDKs) or, with BOXER_HOST_SDL3, a static reduced SDL3. All SDL
+ * use stays behind this one header and mixer.cpp's device code.
  * SDL2 dropped the SDL 1.2 CD-ROM API. Physical-drive CD access through it
  * is reported as "no drives"; image-based CDs (ISO/CUE) do not use it.
  */
 #ifndef BOXER_HOST_SDL_H
 #define BOXER_HOST_SDL_H
 
+#ifdef BOXER_HOST_SDL3
+/* SDL3 host (build flag BOXER_HOST_SDL3, set by scripts/build-core.sh when
+ * BOXER_HOST=sdl3). Only the names the 0.74 core still uses are mapped;
+ * the audio device itself is opened in mixer.cpp, which has an SDL3 path. */
+/* SDL3's own old-name mappings cover SDL_mutex, SDL_SwapLE32 and
+ * AUDIO_S16SYS; without this define it poisons them instead. */
+#define SDL_ENABLE_OLD_NAMES
+#include <SDL3/SDL.h>
+/* Gone in SDL3 (SDL2 compatibility macros returning int); Lock/Unlock now
+ * return void. */
+#define SDL_mutexP(m) (SDL_LockMutex(m), 0)
+#define SDL_mutexV(m) (SDL_UnlockMutex(m), 0)
+/* SDL3 returns Uint64. The core stores ticks in 32-bit fields and compares
+ * sums such as SDL_GetTicks()+ms (parport.cpp), so keep SDL2's 32-bit wrap
+ * semantics everywhere instead of mixing widths. A function-like macro is
+ * not re-expanded inside itself, so this calls the real function. */
+#define SDL_GetTicks() ((Uint32)SDL_GetTicks())
+#else
 #include <SDL2/SDL.h>
+#endif
 
 #define SDL_INIT_CDROM 0
 
