+struct MixerHostStats {
+	Bit32u open_ms, now_ms;           // host ms (SDL_GetTicks) at open / at the query
+	Bit32u mix_ticks;                 // MIXER_Mix calls = emulated ms with a device
+	Bit32u callbacks;                 // device callbacks (SDL2 buffers, SDL3 chunks)
+	Bit64u frames_requested;          // frames the host pulled
+	Bit32u underruns_full;            // nothing delivered (buffer left silent)
+	Bit32u underruns_stretched;       // < 1 % short, stretched
+	Bit32u underruns_low;             // delivered, but below the prebuffer
+	Bit32u overflows;                 // too much queued, dropped/compressed
+	Bit32u freq, blocksize;
+	bool nosound;
+};
+void MIXER_SetHostPaused(bool paused);
+void MIXER_GetHostStats(MixerHostStats *out);
