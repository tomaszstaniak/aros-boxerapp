+#ifdef BOXER_HOST_SDL3
+//SDL3 pulls audio through a stream: the callback is asked for "additional"
+//bytes and must put them into the stream. DOSBox's SDL2-style callback fills
+//a caller-supplied buffer of any size (multiple of a frame) and leaves it
+//untouched on a full underrun, so the buffer is cleared first, as SDL2 did.
+static void SDLCALL MIXER_StreamCallBack(void *userdata, SDL_AudioStream *stream, int additional, int total) {
+	static Uint8 chunk[4096*MIXER_SSIZE];
+	(void)total;
+	additional=(additional+MIXER_SSIZE-1)&~(MIXER_SSIZE-1);
+	while (additional>0) {
+		int len=additional>(int)sizeof(chunk)?(int)sizeof(chunk):additional;
+		memset(chunk,0,len);
+		MIXER_CallBack(userdata,chunk,len);
+		SDL_PutAudioStreamData(stream,chunk,len);
+		additional-=len;
+	}
+}
+#endif
+
+static bool mixer_stopped;
+
 static void MIXER_Stop(Section* sec) {
+	mixer_stats.now_ms=SDL_GetTicks();
+	mixer_stopped=true;
+#ifdef BOXER_HOST_SDL3
+	//Closing the stream also closes its device and joins SDL's device thread,
+	//so no callback runs after the core's mixer is gone.
+	if (mixer_stream) {
+		SDL_AudioStream *stream=mixer_stream;
+		mixer_stream=NULL;
+		SDL_DestroyAudioStream(stream);
+	}
+#endif
+}
+
+//--Added 2026 for the AROS port: pause/resume the host device (Boxer's
+//pause and fast forward) without exposing the host API outside the core.
+void MIXER_SetHostPaused(bool paused) {
+#ifdef BOXER_HOST_SDL3
+	if (!mixer_stream) return;
+	if (paused) SDL_PauseAudioStreamDevice(mixer_stream);
+	else SDL_ResumeAudioStreamDevice(mixer_stream);
+#else
+	SDL_PauseAudio(paused ? 1 : 0);
+#endif
 }
 
+void MIXER_GetHostStats(MixerHostStats *out) {
+	//After MIXER_Stop the counters are final and SDL may be shut down.
+	if (mixer_stopped) { *out=mixer_stats; out->freq=mixer.freq; out->blocksize=mixer.blocksize; out->nosound=mixer.nosound; return; }
+	MIXER_LockHost();
+	*out=mixer_stats;
+	out->now_ms=SDL_GetTicks();
+	out->freq=mixer.freq;
+	out->blocksize=mixer.blocksize;
+	out->nosound=mixer.nosound;
+	MIXER_UnlockHost();
+}
