# Example only. Copy to local.env (ignored) and fill in this machine's paths.
# Values already in the environment win over local.env.
# Relative values resolve from the directory containing local.env.
# Loader: scripts/env.sh. Toolchain dirs contain x86_64-aros-g++.
AROS_V11_TOOLCHAIN=""
AROS_V11_SDK=""
AROS_V1_TOOLCHAIN=""
AROS_V1_SDK=""

# Fonts/ directory of an AROS ISO, for tools/make-fonts.py (build-ui.sh)
AROS_ISO_FONTS=""

# Optional. A directory that must exist before linking: some AROS cross
# toolchains have their build tree's linker path built into collect-aros.
AROS_TOOLCHAIN_MOUNT=""

# Mainline v1 only: host build directory of a mainline AROS build
# (<aros-build>/bin/<host>), for scripts/build-unwind-fix.sh.
AROS_V1_GCC_BUILD=""

# Optional: AROS source checkouts the SDKs were built from; their revision
# is recorded in a package's BUILDINFO.txt.
AROS_V11_SRC=""
AROS_V1_SRC=""

# Optional: local copy of SDL3-3.4.12.tar.gz (default deps/src/, downloaded
# by scripts/build-sdl3.sh when missing; the sha256 is always checked).
SDL3_TARBALL=""
